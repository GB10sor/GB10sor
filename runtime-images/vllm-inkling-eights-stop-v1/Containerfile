COPY inkling-xgrammar-eos.patch /opt/gb10sor/inkling-xgrammar-eos.patch
COPY xgrammar-termination-52805.patch /opt/gb10sor/xgrammar-termination-52805.patch

RUN set -eu; \
    root=/usr/local/lib/python3.12/dist-packages; \
    cd "$root"; \
    echo '231f6b9d7dab5e8d68aba486fa5912db99f8bdd3f9d8842ee3e0bb12bdb7cb67  vllm/v1/structured_output/backend_xgrammar.py' | sha256sum -c -; \
    echo '59aa2cb59932f4148b8a5204d6c5bba92cea57e7fdd2e49b8c3a709b0190bb58  /opt/gb10sor/inkling-xgrammar-eos.patch' | sha256sum -c -; \
    echo 'ea98f2f69005678a27f4c04a830aee92d91d4fbde69655c35fd0fdc2f02fbaa0  /opt/gb10sor/xgrammar-termination-52805.patch' | sha256sum -c -; \
    patch --batch --fuzz=0 -p1 < /opt/gb10sor/inkling-xgrammar-eos.patch; \
    patch --batch --fuzz=0 -p1 < /opt/gb10sor/xgrammar-termination-52805.patch; \
    echo '1545405668692bbab423ecd619d9863708040980ccb1034a5a59444d5ca0468e  vllm/v1/structured_output/backend_xgrammar.py' | sha256sum -c -; \
    python3 -c 'from pathlib import Path; p=Path("vllm/v1/structured_output/backend_xgrammar.py"); compile(p.read_bytes(), str(p), "exec")'

