#!/bin/sh
set -eu

source_model=/model
runtime_model=/tmp/gb10sor-glm53-model
expected_config_sha256=e23c5d98f53e861d49a51bd3c68591621c5482ce829e42c31724152322fba03d

test -r "$source_model/config.json"
observed_config_sha256=$(sha256sum "$source_model/config.json" | awk '{print $1}')
test "$observed_config_sha256" = "$expected_config_sha256"

mkdir -p "$runtime_model"
find "$source_model" -mindepth 1 -maxdepth 1 ! -name config.json -exec ln -s '{}' "$runtime_model/" \;
python3 - "$source_model/config.json" "$runtime_model/config.json" <<'PY'
import json
import sys

source, destination = sys.argv[1:]
with open(source, encoding="utf-8") as handle:
    config = json.load(handle)
text_config = config["text_config"]
assert text_config["qk_rope_head_dim"] == 0
assert text_config["index_topk"] == 2048
assert text_config["index_kpool"] == 4
text_config["index_topk"] = 2044
with open(destination, "w", encoding="utf-8") as handle:
    json.dump(config, handle, sort_keys=True, separators=(",", ":"))
    handle.write("\n")
PY

set -- "$@"
if test "${1-}" = serve && test "${2-}" = /model; then
    shift 2
    set -- serve "$runtime_model" "$@"
fi
exec /usr/local/bin/vllm "$@"
